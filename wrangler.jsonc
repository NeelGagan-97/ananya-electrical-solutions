{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ananya-electrical-solutions",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
